---
/**
 * BaseLayout Component
 *
 * The main layout wrapper for all pages. Includes:
 * - HTML document structure
 * - Meta tags and SEO
 * - Global styles import
 * - Announcement bar
 * - Header navigation
 * - Footer
 * - Scroll animation observer
 * - View transitions (Astro)
 *
 * Props:
 * @prop {string} title - Page title (appended to site name)
 * @prop {string} description - Meta description for SEO
 * @prop {string} image - OG image URL for social sharing
 * @prop {boolean} showAnnouncement - Whether to show announcement bar
 */

import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import { REGISTER_LINK } from "../data/links";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showAnnouncement?: boolean;
}

const {
  title = "Raising Kingdom Visionaries",
  description = "Adullam Academy is a School of Innovation that equips kids and teenagers with technical mastery, AI engineering, and Kingdom-first leadership skills to prepare them for effectiveness in the new age.",
  image = "/logos/logo.png",
  showAnnouncement = true,
} = Astro.props;

const siteTitle = `${title} | Adullam Academy`;
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://adullamacademy.com",
);
const ogImageURL = new URL(image, Astro.site || "https://adullamacademy.com");
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Basic Meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta -->
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Adullam Academy, Christian coding bootcamp, AI engineering for kids, Kingdom-first leadership, Christian innovation school, Christian tech education" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logos/logo.png" />
    <link rel="apple-touch-icon" href="/logos/logo.png" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Adullam Academy" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={new URL(Astro.site || "https://adullamacademy.com").hostname} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- View Transitions -->
    <ViewTransitions />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Adullam Academy",
      "url": "https://adullamacademy.com",
      "logo": "https://adullamacademy.com/logos/logo.png",
      "description": "Adullam Academy is a School of Innovation that equips kids and teenagers with technical mastery, AI engineering, and Kingdom-first leadership skills."
    })} />

    <script
      defer
      is:inline
      src="https://cloud.umami.is/script.js"
      data-website-id="e885c0c6-de75-452b-8e83-7e833ffb88eb"></script>
  </head>

  <body class="bg-cream text-navy-900 antialiased overflow-x-hidden">
    <!-- Skip to main content (Accessibility) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-gold-500 focus:text-navy-900 focus:rounded-lg"
    >
      Skip to main content
    </a>

    <!-- Announcement Bar -->
    {
      showAnnouncement && (
        <AnnouncementBar
          message="Registration is open for the Jun 20 – Aug 16 online cohort"
          link={REGISTER_LINK}
          linkText="Save My Spot"
        />
      )
    }

    <!-- Header -->
    <Header />

    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Scroll Animation Observer -->
    <script>
      /**
       * Intersection Observer for Scroll Animations
       *
       * Watches elements with animation classes and triggers
       * animations when they enter the viewport.
       */

      const observerOptions = {
        root: null,
        rootMargin: "0px 0px -100px 0px",
        threshold: 0.1,
      };

      const animationClasses = [
        "animate-on-scroll",
        "animate-on-scroll-left",
        "animate-on-scroll-right",
        "animate-on-scroll-scale",
      ];

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.setAttribute("data-visible", "true");
          }
        });
      }, observerOptions);

      // On every page load (including initial), immediately show in-viewport elements
      // and use the observer for off-screen elements.
      document.addEventListener("astro:page-load", () => {
        observer.disconnect();

        animationClasses.forEach((className) => {
          document.querySelectorAll(`.${className}`).forEach((el) => {
            el.removeAttribute("data-visible");
            const rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight && rect.bottom > 0) {
              el.setAttribute("data-visible", "true");
            } else {
              observer.observe(el);
            }
          });
        });
      });
    </script>

    <!-- Smooth scroll polyfill for Safari -->
    <script>
      // Check if smooth scroll is supported
      if (!("scrollBehavior" in document.documentElement.style)) {
        // Polyfill for smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener("click", (e) => {
            e.preventDefault();
            const href = (e.currentTarget as HTMLAnchorElement).getAttribute(
              "href",
            );
            const target = href ? document.querySelector(href) : null;
            if (target) {
              target.scrollIntoView({ behavior: "smooth" });
            }
          });
        });
      }
    </script>

    <!-- Referral Tracking & Affiliate Management -->
    <script is:inline define:vars={{ REGISTER_LINK }}>
      /**
       * Captures ?referral=ID on the home page, saves it to a cookie for 30 days,
       * and appends it to all registration links across the site.
       */
      function initReferralTracking() {
        const urlParams = new URLSearchParams(window.location.search);
        const referralId = urlParams.get('referral');

        // 1. Capture & Store 
        if (referralId) {
          // Set cookie for 30 days
          const expires = new Date();
          expires.setTime(expires.getTime() + (30 * 24 * 60 * 60 * 1000));
          document.cookie = `referral=${referralId};expires=${expires.toUTCString()};path=/;SameSite=Lax`;

          // 2. Clean URL: Remove referral param from address bar
          const newUrl = new URL(window.location.href);
          newUrl.searchParams.delete('referral');
          window.history.replaceState({}, document.title, newUrl.pathname + newUrl.search);
        }

        // 3. Apply: Read cookie and decorate registration links
        const savedReferral = document.cookie
          .split('; ')
          .find(row => row.startsWith('referral='))
          ?.split('=')[1];

        if (savedReferral) {
          // Find all links starting with the registration base URL
          const regLinks = document.querySelectorAll(`a[href^="${REGISTER_LINK}"]`);
          
          regLinks.forEach(link => {
            try {
              const url = new URL(link.href);
              url.searchParams.set('referral', savedReferral);
              link.href = url.toString();
            } catch (e) {
              // Fallback for invalid URLs or unexpected relative paths
              console.error('Error updating referral link:', e);
            }
          });
        }
      }

      // Initialize on load and after every Astro page transition
      document.addEventListener('astro:page-load', initReferralTracking);
    </script>
  </body>
</html>

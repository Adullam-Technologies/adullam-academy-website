---
/**
 * About Page - Redesigned for Adullam Academy: School of Innovation
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CoreValue from "../components/CoreValue.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import { getCollection } from "astro:content";

// Fetch FAQs from content collection
const faqs = await getCollection("faq", ({ data }) => {
  return data.published === true;
});

// Sort by order and transform for FAQ component
const sortedFaqs = await Promise.all(
  faqs
    .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
    .map(async (faq) => {
      const { Content } = await faq.render();
      return {
        question: faq.data.question,
        answer: Content,
      };
    }),
);

// Core values data
const coreValues = [
  {
    title: "Kingdom-First Living",
    verse:
      "But seek first the kingdom of God and His righteousness, and all these things shall be added to you.",
    reference: "Matthew 6:33 (NKJV)",
  },
  {
    title: "Impact-Driven Work",
    verse:
      "Let your light so shine before men, that they may see your good works and glorify your Father in heaven.",
    reference: "Matthew 5:16 (NKJV)",
  },
  {
    title: "Excellence",
    verse:
      "Do you see a man who excels in his work? He will stand before kings; He will not stand before unknown men.",
    reference: "Proverbs 22:29 (NKJV)",
  },
  {
    title: "Servant Leadership",
    verse: "But he who is greatest among you shall be your servant.",
    reference: "Matthew 23:11 (NKJV)",
  },
  {
    title: "Spiritual Wisdom",
    verse:
      "But we speak the wisdom of God in a mystery, the hidden wisdom which God ordained before the ages for our glory... For 'who has known the mind of the LORD that he may instruct Him?' But we have the mind of Christ.",
    reference: "1 Corinthians 2:7, 16 (NKJV)",
  },
  {
    title: "Prayer & Meditation",
    verse:
      "This Book of the Law shall not depart from your mouth, but you shall meditate in it day and night, that you may observe to do according to all that is written in it. For then you will make your way prosperous, and then you will have good success.",
    reference: "Joshua 1:8 (NKJV)",
  },
];

const leadershipMembers = [
  {
    name: "Abimbola Ogunsola",
    role: "Head of Presence",
    linkedin: "https://www.linkedin.com/in/beeogunsola/",
    email: "abimbola@adullamacademy.com",
    image: "/images/abimbola-ogunsola.jpeg",
  },
  {
    name: "Ife Odelana",
    role: "Head of Finance",
    linkedin: "https://www.linkedin.com/in/ife-odelana-/",
    email: "ife@adullamacademy.com",
    image: "/images/ife-odelana.jpg",
  },
];

const teamMembers = [
  {
    name: "Koyinsola Aiyedogbon",
    role: "Cohort Coordinator",
    linkedin: "https://www.linkedin.com/in/koyinsolaaiy/",
    email: "koyinsola@adullamacademy.com",
    image: "/images/koyinsola.webp",
  },
  {
    name: "Jospin Muhanuzi",
    role: "Software Engineer",
    linkedin: "https://www.linkedin.com/in/jospin-muhanuzi/",
    email: "jospin.instructor@gmail.com",
    image: "/images/jospin.webp",
  },
  {
    name: "Eniola Olomolatan",
    role: "Creative Director",
    linkedin: "https://www.linkedin.com/in/eniola-olomolatan/",
    email: "eniola.olomolatan@gmail.com",
    image: "/images/eniola.webp",
  },
  {
    name: "Justina Nemhara",
    role: "Finance Coordinator",
    linkedin: "https://www.linkedin.com/in/justinanemhara/",
    email: "justinanemhara180@gmail.com",
    image: "/images/justina.webp",
  },
];
---

<BaseLayout
  title="About Us | Our Leadership & Mission"
  description="Meet the team at Adullam Academy. Discover our mission to raise Kingdom-first tech leaders through Christian innovation."
>
  <!-- Hero Section -->
  <section
    class="relative min-h-[60vh] flex items-center gradient-hero overflow-hidden"
  >
    <!-- Background elements -->
    <div class="absolute inset-0">
      <div
        class="absolute top-1/4 left-1/4 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-electric-500/10 rounded-full blur-3xl animate-float"
        style="animation-delay: -3s;"
      >
      </div>
    </div>

    <div class="container mx-auto px-4 lg:px-8 py-32 relative z-10 text-center">
      <p
        class="text-gold-400 font-semibold tracking-wider uppercase mb-4 animate-on-scroll"
      >
        Who We Are
      </p>
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-6 leading-tight animate-on-scroll max-w-4xl mx-auto"
      >
        The School of <span class="gradient-text">Innovation</span>
      </h1>
      <p class="text-xl text-white/80 max-w-2xl mx-auto animate-on-scroll">
        Guided by God's wisdom, powered by proprietary technology, and dedicated to raising the next generation of Kingdom leaders.
      </p>
    </div>
  </section>

  <!-- Mission & Vision Section - CORE: NEVER REMOVE OR ALTER -->
  <section class="py-24 lg:py-32 bg-cream">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 max-w-6xl mx-auto">
        <!-- Mission Card -->
        <div class="bg-white p-8 lg:p-12 rounded-3xl shadow-soft border border-navy-100/30 animate-on-scroll card-hover">
          <div
            class="inline-block px-4 py-2 bg-gold-500/10 rounded-full text-gold-600 text-sm font-semibold mb-6"
          >
            Our Mission
          </div>
          <p class="text-xl lg:text-2xl text-navy-800 leading-relaxed font-medium">
            Adullam Academy is a technocentric school of innovation with a
            mandate to teach kids and teenagers about the <span
              class="text-gold-600 font-semibold"
              >creative dimension of God</span
            >, purpose-driven living and systematic innovation, equipping them to
            be pioneers, founders and leaders who <span
              class="text-gold-600 font-semibold"
              >advance God's Kingdom on earth</span
            >.
          </p>
        </div>

        <!-- Vision Card -->
        <div class="bg-white p-8 lg:p-12 rounded-3xl shadow-soft border border-navy-100/30 animate-on-scroll card-hover" style="animation-delay: 0.2s;">
          <div
            class="inline-block px-4 py-2 bg-gold-500/10 rounded-full text-gold-600 text-sm font-semibold mb-6"
          >
            Our Vision
          </div>
          <p class="text-xl lg:text-2xl text-navy-800 leading-relaxed font-medium">
            To raise a generation of youths who can <span
              class="text-gold-600 font-semibold"
              >identify real-world problems</span
            >, receive God-inspired ideas, and <span
              class="text-gold-600 font-semibold"
              >transform those ideas into digital solutions</span
            > that bring value and lasting impact for Jesus Christ.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Founder Bio -->
  <section class="py-24 lg:py-32 bg-cream-dark">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center max-w-6xl mx-auto">
        <div class="animate-on-scroll-left">
           <div class="relative group max-w-md mx-auto">
              <div class="absolute inset-0 bg-linear-to-br from-gold-500/20 to-navy-500/20 rounded-3xl blur-xl group-hover:scale-105 transition-transform duration-500"></div>
                <img
                src="/images/founder-new.png"
                alt="Obaloluwa Odelana, Founder of Adullam Academy"
                class="relative rounded-3xl shadow-2xl grayscale hover:grayscale-0 transition-all duration-700"
              />
              <div class="absolute -bottom-6 -right-6 bg-navy-900 text-gold-500 p-6 rounded-2xl shadow-xl">
                <p class="text-xs font-bold uppercase tracking-widest mb-1">Founder</p>
                <p class="text-lg font-extrabold">Obaloluwa Odelana</p>
              </div>
           </div>
        </div>
        <div class="animate-on-scroll-right">
          <h2 class="text-3xl lg:text-4xl font-extrabold text-navy-900 mb-8 leading-tight">Driven by a Vision for <span class="text-gold-600">Kingdom Effectiveness</span></h2>
          <div class="space-y-6 text-lg text-navy-700 leading-relaxed">
            <p>
              Obaloluwa Odelana is a Kingdom entrepreneur and software engineer with a background in <strong>AI research, automation engineering, and full-stack development</strong> across industry and academic settings. He has coached over 100 students in software development and led multiple high-impact youth innovation bootcamps.
            </p>
            <p>
              Adullam Academy is the expression of his technical and spiritual vision. Here, we bridge the gap between faith and technology, blending <strong>technical skill-building with Scripture</strong> to raise Kingdom-first innovators empowered to solve real-world problems.
            </p>
            <p>
              His work at the Academy focuses on engineering the <strong>Adullam Method</strong>, a Socratic, AI-driven learning approach that guides students toward technical mastery through the lens of God's creative wisdom.
            </p>
          </div>
          <div class="mt-8">
            <a href="https://www.linkedin.com/in/obaodelana/" target="_blank" class="inline-flex items-center gap-2 text-gold-600 font-bold hover:text-gold-700 transition-colors">
              Read the Technical Summary on LinkedIn
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership Section -->
  <section class="py-24 lg:py-32 bg-cream">
    <div class="container mx-auto px-4 lg:px-8">
      <SectionHeader
        eyebrow="Our Leadership"
        title="Institutional Excellence"
        description="A leadership team committed to operational integrity, communal presence, and technical innovation."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-3xl mx-auto mt-16">
        {
          leadershipMembers.map((member, index) => (
            <div
              class="group animate-on-scroll"
              style={`animation-delay: ${index * 0.1}s;`}
            >
              <div class="relative mb-6 aspect-[4/5] overflow-hidden rounded-2xl bg-navy-100">
                <div class="absolute inset-0 bg-linear-to-t from-navy-900/60 to-transparent z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                {member.image && (
                  <img
                    src={member.image}
                    alt={`${member.name}, ${member.role} at Adullam Academy`}
                    class="h-full w-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
                  />
                )}
                <div class="absolute bottom-4 left-4 z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <a href={member.linkedin} target="_blank" class="p-2 bg-gold-500 rounded-full inline-block">
                    <svg class="w-4 h-4 text-navy-900" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" /></svg>
                  </a>
                </div>
              </div>
              <h3 class="text-xl font-extrabold text-navy-900">{member.name}</h3>
              <p class="text-gold-600 font-bold text-sm uppercase tracking-widest">{member.role}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-24 lg:py-32 bg-cream-dark">
    <div class="container mx-auto px-4 lg:px-8">
      <SectionHeader
        eyebrow="Our Team"
        title="Mission-Aligned Builders"
        description="The dedicated team working behind the scenes to deliver a world-class educational experience."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto mt-16">
        {
          teamMembers.map((member, index) => (
            <div
              class="group animate-on-scroll"
              style={`animation-delay: ${index * 0.1}s;`}
            >
              <div class="relative mb-6 aspect-square overflow-hidden rounded-2xl bg-navy-100">
                <div class="absolute inset-0 bg-linear-to-t from-navy-900/40 to-transparent z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                {member.image && (
                  <img
                    src={member.image}
                    alt={`${member.name}, ${member.role} at Adullam Academy`}
                    class="h-full w-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
                  />
                )}
                <div class="absolute bottom-4 left-4 z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex gap-2">
                  <a href={member.linkedin} target="_blank" class="p-1.5 bg-gold-500 rounded-full inline-block">
                    <svg class="w-3.5 h-3.5 text-navy-900" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" /></svg>
                  </a>
                </div>
              </div>
              <h3 class="text-lg font-bold text-navy-900">{member.name}</h3>
              <p class="text-gold-600 font-bold text-xs uppercase tracking-widest">{member.role}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Core Values Section -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <SectionHeader
        eyebrow="Foundation"
        title="Kingdom-First Pillars"
        description="Our work is built on eternal principles that transcend technical trends."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto mt-12">
        {
          coreValues.map((value, index) => (
            <CoreValue
              title={value.title}
              verse={value.verse}
              reference={value.reference}
              delay={index * 0.1}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="py-24 lg:py-32 bg-cream scroll-mt-24">
    <div class="container mx-auto px-4 lg:px-8">
      <SectionHeader
        eyebrow="Integrity"
        title="Frequently Asked Questions"
        description="Providing clarity for parents and organizations."
      />

      <div class="max-w-3xl mx-auto mt-12">
        <FAQ items={sortedFaqs} allowMultiple={true} title="" />
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTA
    headline="Join the Mission"
    subtext="Invest in your child's effectiveness as a Kingdom leader in the age of innovation."
    primaryCTA="Enrol Today"
    primaryLink="/bootcamp"
  />
</BaseLayout>

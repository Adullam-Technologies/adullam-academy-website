---
import BaseLayout from "../layouts/BaseLayout.astro";
import { WORKSHOPS_LINK } from "../data/links";
---

<BaseLayout title="Share the Mission" description="Help more families discover Adullam Academy's free technology workshops for ages 8–16 and our mission to raise Kingdom-first leaders.">
  <section class="bg-linear-to-br from-navy-800 to-navy-950 text-white py-24">
    <div class="mx-auto max-w-5xl px-6 lg:px-8"><p class="text-gold-300 uppercase tracking-widest text-xs font-bold mb-5">Kingdom impact, together</p><h1 class="text-4xl lg:text-6xl font-extrabold">Share the opportunity.<br /><span class="text-gold-300">Help a young creator grow.</span></h1><p class="text-white/75 text-lg leading-relaxed max-w-2xl mt-7">Help us raise the next generation of Kingdom-first leaders. Introduce a family, church, or community to our free workshops for ages 8–16.</p><a href={WORKSHOPS_LINK} class="btn-primary mt-8">Explore the Workshop Calendar ↗</a></div>
  </section>
  <section class="py-20 bg-cream"><div class="mx-auto max-w-5xl px-6 lg:px-8 grid md:grid-cols-2 gap-12"><div><h2 class="text-2xl font-bold mb-4">An invitation worth sharing</h2><p class="text-navy-600 leading-relaxed">Our current workshops are free. Share our Luma calendar so families can choose a session, see the details, and register directly.</p></div><div><h2 class="text-2xl font-bold mb-4">Connect with the Academy</h2><p class="text-navy-600 leading-relaxed mb-6">Want to help bring Kingdom-first technology education to your community? We'd love to hear from you.</p><a href="/contact" class="font-semibold underline underline-offset-4">Talk to our team ↗</a></div></div></section>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import WorkshopInvitation from "../components/WorkshopInvitation.astro";
import { WORKSHOPS_LINK } from "../data/links";

const testimonials = (await getCollection("testimonials", ({ data }) => data.published))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const awardsPath = "/images/projects/awards-night-aug-2026";
const studentProjects = [
  {
    title: "Stickman Oceanic Odyssey",
    category: "AI filmmaking",
    description: "An ocean adventure brought to life through original characters, imaginative artwork, and AI filmmaking.",
    image: `${awardsPath}/abimbolas-ai-video.jpeg`,
    alt: "Student-created ocean adventure artwork featuring colourful stick-figure sea creatures",
    width: 1152,
    height: 648,
  },
  {
    title: "Front Row Faith",
    category: "AI filmmaking",
    description: "From character ideas to scenes and a finished edit: a student-created film exploring the possibilities of AI storytelling.",
    image: `${awardsPath}/myla-ai-video.jpeg`,
    alt: "A scene from the student AI film Front Row Faith shown during the presentation",
    width: 1279,
    height: 516,
  },
  {
    title: "A personal music assistant",
    category: "AI engineering · Team Chicken Inventors",
    description: "An AI agent that helps people discover music, learn about artists, and write songs. Built around a shared love of music.",
    image: `${awardsPath}/team-chicken-inventors-ai-agent.jpeg`,
    alt: "Team Chicken Inventors' music assistant generating a song concept and inviting the user to write lyrics",
    width: 1280,
    height: 641,
  },
  {
    title: "Run David Run!",
    category: "2D adventure game",
    description: "A student-built 2D adventure, turning an idea into a playable game.",
    image: "/images/projects/run-david-run.gif",
    alt: "Run David Run 2D game demo built by an Adullam Academy student",
    width: 800,
    height: 450,
  },
  {
    title: "Bible Bop",
    category: "Trivia game",
    description: "A student-created Bible trivia game bringing faith and interactive play together.",
    image: "/videos/student-showcase/biblebop.gif",
    alt: "Bible Bop trivia game demo built by an Adullam Academy student",
    width: 800,
    height: 450,
  },
  {
    title: "Eseosa's Agent",
    category: "AI research agent",
    description: "A student-built AI research agent demonstrating practical skills in AI development.",
    image: "/videos/student-showcase/ai-agent.gif",
    alt: "Eseosa's AI research agent demo built by an Adullam Academy student",
    width: 800,
    height: 450,
  },
];
const approach = [
  { title: "Kingdom first. Always.", text: "Our foundation is Jesus Christ. We help young Visionaries connect their creativity with God's Word and His purpose for their lives." },
  { title: "Create, don't just consume.", text: "Ideas become something you can see, share, and improve. Students explore technology by making things with it." },
  { title: "Excellence grows here.", text: "Guidance, practice, and thoughtful feedback help students develop the confidence to present their work and keep growing." },
];
---

<BaseLayout title="The School of Innovation" description="Adullam Academy is a Christian School of Innovation raising Kingdom-first leaders. Explore student creations and our current free workshops for ages 8–16." showAnnouncement={false}>
  <section class="relative overflow-hidden bg-navy-900 text-white">
    <div class="absolute inset-0 bg-linear-to-br from-navy-800 via-navy-900 to-navy-950" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-6 lg:px-8 py-20 lg:py-28 text-center">
      <div>
        <p class="text-gold-400 text-xs font-bold uppercase tracking-[0.22em] mb-7">The School of Innovation</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.08] tracking-tight">Empowering the Next Generation of <span class="text-gold-300">Kingdom Visionaries.</span></h1>
        <p class="mt-7 mx-auto max-w-2xl text-lg leading-relaxed text-white/75">Adullam Academy is a Kingdom-first preparation ground where your child learns to build apps, create AI-powered solutions, and bring God-inspired ideas to life.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-5 items-center">
          <a href={WORKSHOPS_LINK} target="_blank" rel="noopener noreferrer" class="btn-primary">Explore Free Workshops <span aria-hidden="true">↗</span></a>
          <a href="#student-work" class="text-sm font-semibold text-white border-b border-white/40 pb-1 hover:border-gold-300 hover:text-gold-300">See what students create <span aria-hidden="true">↓</span></a>
        </div>
        <p class="mt-7 text-sm text-white/60">Happening now: free workshops for ages 8–16.</p>
      </div>
    </div>
  </section>

  <WorkshopInvitation />

  <section id="student-work" class="bg-cream py-20 lg:py-28 scroll-mt-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid md:grid-cols-[1.2fr_1fr] gap-6 items-end mb-12">
        <div><p class="text-navy-600 text-xs font-bold uppercase tracking-[0.2em] mb-4">The work speaks</p><h2 class="text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">Young minds.<br />Remarkable creations.</h2></div>
        <p class="text-navy-600 leading-relaxed max-w-md md:ml-auto">Games, original films, and working AI agents. Explore creations from across the Academy, including our August 2026 Presentation &amp; Awards Night.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {studentProjects.map((project) => (
          <article class="rounded-2xl overflow-hidden bg-white border border-navy-900/10">
            <img
              src={project.image}
              alt={project.alt}
              width={project.width}
              height={project.height}
              loading="lazy"
              decoding="async"
              class="w-full aspect-video object-cover"
            />
            <div class="p-7">
              <p class="text-xs uppercase tracking-widest text-navy-600 mb-3">{project.category}</p>
              <h3 class="text-2xl font-bold mb-3">{project.title}</h3>
              <p class="text-navy-600 leading-relaxed">{project.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Awards celebration temporarily hidden; the cohort page links to the recording.
  <section id="awards" class="bg-navy-900 text-white py-20 lg:py-28 relative overflow-hidden scroll-mt-24">
    <div class="absolute inset-0 bg-linear-to-tr from-navy-950 via-transparent to-navy-700/30" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
      <div class="flex flex-wrap justify-between items-center gap-4 pb-7 mb-10 border-b border-white/15"><p class="text-gold-300 uppercase tracking-[0.2em] text-xs font-bold">Adullam Academy honours</p><p class="text-white/60 text-sm">Presentation &amp; Awards Night / August 2026</p></div>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <h2 class="text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">Student excellence,<br /><span class="text-gold-300">celebrated.</span></h2>
          <p class="text-white/70 leading-relaxed mt-6">Our students presented their creations, explained their process, and received thoughtful feedback from a guest panel spanning investment, education, and leadership.</p>
          <div class="mt-9 space-y-6">
            <div class="border-l-2 border-gold-500 pl-5"><p class="text-xs text-gold-300 uppercase tracking-widest mb-2">Cinematic Visionary Award</p><h3 class="text-xl font-bold">Olivia · The Notebook</h3><p class="text-white/65 text-sm mt-2">Recognised for storytelling, polished editing, and a confident presentation.</p></div>
            <div class="border-l-2 border-gold-500 pl-5"><p class="text-xs text-gold-300 uppercase tracking-widest mb-2">Engineering Vanguard Award</p><h3 class="text-xl font-bold">Team Chicken Inventors</h3><p class="text-white/65 text-sm mt-2">Recognised for their working music agent, preparation, and teamwork.</p></div>
          </div>
        </div>
        <div>
          <div class="aspect-video rounded-2xl border border-gold-400/30 bg-linear-to-br from-navy-800 to-navy-950 flex flex-col justify-center items-center text-center p-8">
            <span class="text-5xl text-gold-300 mb-5" aria-hidden="true">✦</span>
            <p class="text-xs uppercase tracking-[0.2em] text-gold-300 mb-3">A night to remember</p>
            <p class="text-2xl font-heading font-bold">Highlights coming soon</p>
            <p class="text-sm text-white/60 mt-3">Celebrating our students and their creations.</p>
          </div>
          <p class="mt-7 text-xs uppercase tracking-widest text-gold-300">With guest judges</p>
          <ul class="mt-3 space-y-2 text-white/75 text-sm"><li><strong class="text-white">Lise Birikundavyi</strong> · BKR Capital</li><li><strong class="text-white">Sean Graves</strong> · University of Alberta</li><li><strong class="text-white">Dr. Ebere Morgan</strong> · Leadership educator</li></ul>
        </div>
      </div>
      <p class="mt-12 pt-7 border-t border-white/15 text-white/65 max-w-3xl leading-relaxed">We celebrate achievement—and the growth behind it. Every presentation reflects curiosity, perseverance, and a young creator learning to use their gifts with purpose.</p>
    </div>
  </section>

  */}

  <section class="py-20 lg:py-28 bg-cream">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-navy-600 mb-4">The Adullam foundation</p>
      <div class="flex flex-wrap justify-between items-end gap-6 mb-12"><h2 class="text-4xl lg:text-5xl font-extrabold tracking-tight max-w-2xl">More than skills.<br />A sense of purpose.</h2><a href="/about" class="font-semibold border-b border-navy-900 pb-1 hover:text-navy-500">Discover our mission <span aria-hidden="true">↗</span></a></div>
      <div class="grid md:grid-cols-3 gap-8">{approach.map((item, index) => <article class="border-t border-navy-900/20 pt-6"><span class="text-navy-500 text-sm font-mono">0{index + 1}</span><h3 class="text-xl font-bold mt-6 mb-4">{item.title}</h3><p class="text-navy-600 leading-relaxed">{item.text}</p></article>)}</div>
    </div>
  </section>

  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-8 items-end mb-10"><div><p class="text-xs font-bold uppercase tracking-[0.2em] text-navy-600 mb-4">Inside the Academy</p><h2 class="text-3xl lg:text-4xl font-extrabold">Tools built for young Visionaries.</h2></div><p class="text-navy-600 leading-relaxed max-w-lg">Beyond any one workshop or cohort, our learning environment brings technical exploration and Kingdom-first purpose together.</p></div>
      <div class="grid md:grid-cols-2 gap-8">
        <article class="rounded-2xl border border-navy-900/10 overflow-hidden bg-cream"><img src="/images/software/lms/dashboard.png" alt="Adullam Academy learning dashboard" width="800" height="600" loading="lazy" decoding="async" class="w-full aspect-video object-cover object-top" /><div class="p-7"><h3 class="text-xl font-bold mb-3">A tailored learning environment</h3><p class="text-navy-600 leading-relaxed">Interactive lessons, an integrated code editor, and progress tracking support focused learning and technical growth.</p></div></article>
        <article class="rounded-2xl border border-navy-900/10 overflow-hidden bg-cream"><img src="/images/software/ai-studio/studio.png" alt="Adullam Academy AI Studio interface for building AI applications" width="800" height="600" loading="lazy" decoding="async" class="w-full aspect-video object-cover object-top" /><div class="p-7"><h3 class="text-xl font-bold mb-3">Guided AI development</h3><p class="text-navy-600 leading-relaxed">The Adullam AI Studio gives students a space to explore AI applications with guidance grounded in our Kingdom-first values.</p></div></article>
      </div>
    </div>
  </section>

  <section class="bg-cream-dark py-20 lg:py-24">
    <div class="mx-auto max-w-5xl px-6 lg:px-8"><p class="text-xs font-bold uppercase tracking-[0.2em] text-navy-600 text-center mb-4">From our families</p><h2 class="text-3xl lg:text-4xl font-extrabold text-center mb-12">Growth parents can see.</h2><TestimonialCarousel testimonials={testimonials} /></div>
  </section>
  <section class="bg-gold-200 py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 flex flex-col lg:flex-row gap-8 justify-between items-start lg:items-center"><div><p class="text-xs font-bold uppercase tracking-[0.2em] mb-4">Their next idea starts here</p><h2 class="text-3xl lg:text-4xl font-extrabold">Make room for their potential.</h2><p class="mt-4 text-navy-700">Discover the Academy through our current free workshops for ages 8–16.</p><a href="/bootcamp" class="inline-block mt-4 font-semibold underline underline-offset-4">Looking ahead to future cohorts? →</a></div><a href={WORKSHOPS_LINK} target="_blank" rel="noopener noreferrer" class="btn-primary">See Upcoming Workshops <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>

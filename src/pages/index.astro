---
/**
 * Homepage - Redesigned for Adullam Academy: School of Innovation
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Countdown from '../components/Countdown.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureCard from '../components/FeatureCard.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import CTA from '../components/CTA.astro';
import { REGISTER_LINK } from '../data/links';
import { getCollection } from 'astro:content';

// Fetch testimonials from content collection
const testimonials = await getCollection('testimonials', ({ data }) => {
  return data.published === true;
});

// Sort by order
const sortedTestimonials = testimonials.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

// The Adullam Method - Focused on Effectiveness & Impact
const approachItems = [
  {
    number: 1,
    title: "Learn by Building",
    description: "Students become creators instead of just consumers. During our 8-week bootcamps, teams work together to build and ship real solutions.",
  },
  {
    number: 2,
    title: "Spirit-Led Innovation",
    description: "Every session starts with prayer and ends with a 'Wisdom Cache' from the Bible. We ground every new idea in the wisdom of God's Word.",
  },
  {
    number: 3,
    title: "Team-Centred Projects",
    description: "Students work in small groups to solve real-world problems. This helps them develop the leadership and teamwork skills they need to succeed.",
  },
  {
    number: 4,
    title: "Designed for Real Impact",
    description: "Our bootcamps are structured, focused, and age-appropriate. Your child will leave with a working prototype, new skills, and a renewed sense of purpose.",
  },
];
---

<BaseLayout 
  title="The School of Innovation"
  description="Adullam Academy is a Christian School of Innovation equipping the next generation of Kingdom-first leaders with the tools of innovation, AI engineering, and spiritual effectiveness."
>
  <!-- Hero Section -->
  <Hero 
    headline="Empowering the Next Generation of Kingdom Visionaries"
    subtext="Adullam Academy is a Kingdom-first preparation ground where your child masters how to build apps and AI-powered solutions."
    primaryCTA="Enrol Your Child"
    primaryLink="/bootcamp"
    secondaryCTA="See the Vision"
    secondaryLink="/about"
  />

  <!-- Countdown Section -->
  <section id="about" class="py-12 lg:py-16 bg-navy-950 border-y border-gold-500/20 relative">
    <div class="absolute inset-0 noise-overlay opacity-10"></div>
    <div class="container mx-auto px-4 lg:px-8 relative z-10 text-center">
      <Countdown targetDate="2026-06-20T09:00:00" />
      <div class="mt-10 animate-on-scroll" style="animation-delay: 1.1s;">
        <a href="/bootcamp" class="btn-primary text-lg px-8 py-4 inline-flex items-center justify-center gap-2">
          Register Now
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- The "Vision" Video Section (Hidden until video is ready) -->
  {/*
  <section id="vision" class="py-24 lg:py-32 bg-white relative overflow-hidden">
    ...
  </section>
  */}

  <!-- The Innovation Lab (Moat Showcase) -->
  <section class="py-24 lg:py-32 bg-cream relative">
    <div class="container mx-auto px-4 lg:px-8">
      <SectionHeader 
        eyebrow="The Adullam Method"
        title="Our Proprietary Innovation Lab"
        description="We don't use off-the-shelf tools. We've built a custom ecosystem where technical rigor meets spiritual safety."
      />

      <div class="mt-20 space-y-32">
        <!-- Feature 1: The LMS -->
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="animate-on-scroll-left">
            <h3 class="text-3xl font-extrabold text-navy-900 mb-6">A Tailored Learning Management System</h3>
            <p class="text-lg text-navy-700 leading-relaxed mb-8">
              Your child's progress is tracked in a professional-grade dashboard designed for focus. From interactive lessons to an integrated code editor, every tool is engineered to build technical effectiveness.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-3 text-navy-600">
                <svg class="w-6 h-6 text-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Integrated Code Editor for instant feedback</span>
              </li>
              <li class="flex items-start gap-3 text-navy-600">
                <svg class="w-6 h-6 text-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Gamified progress and skill tracking</span>
              </li>
            </ul>
          </div>
          <div class="animate-on-scroll-right">
            <div class="relative group">
              <div class="absolute -inset-4 bg-linear-to-br from-gold-500/20 to-navy-500/10 rounded-3xl blur-2xl group-hover:opacity-75 transition duration-500"></div>
              <img src="/images/software/lms/dashboard.png" loading="lazy" width="800" height="600" alt="Adullam Academy LMS Platform Dashboard" class="relative rounded-2xl shadow-2xl border border-navy-100/50" />
            </div>
          </div>
        </div>

        <!-- Feature 2: AI Studio -->
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="order-2 lg:order-1 animate-on-scroll-left">
            <div class="relative group">
              <div class="absolute -inset-4 bg-linear-to-br from-electric-500/20 to-navy-500/10 rounded-3xl blur-2xl group-hover:opacity-75 transition duration-500"></div>
              <img src="/images/software/ai-studio/studio.png" loading="lazy" width="800" height="600" alt="Adullam Academy AI Studio Interface" class="relative rounded-2xl shadow-2xl border border-navy-100/50" />
            </div>
          </div>
          <div class="order-1 lg:order-2 animate-on-scroll-right">
            <h3 class="text-3xl font-extrabold text-navy-900 mb-6">Safe, Guided AI Development</h3>
            <p class="text-lg text-navy-700 leading-relaxed mb-8">
              The Adullam AI Studio is a protected frontier where students learn to <strong>use and develop their own AI applications</strong>. Using our <strong>Eureka Agent</strong> approach, we guide students through complex concepts, ensuring every innovation is safe and spiritually aligned.
            </p>
            <ul class="space-y-4 mb-8">
              <li class="flex items-start gap-3 text-navy-600">
                <svg class="w-6 h-6 text-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Socratic tutoring for building custom AI apps</span>
              </li>
              <li class="flex items-start gap-3 text-navy-600">
                <svg class="w-6 h-6 text-gold-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Rigorous safety filters for profane-free learning</span>
              </li>
            </ul>
            <a href="/bootcamp" class="inline-flex items-center gap-2 text-gold-600 font-bold hover:text-gold-700 transition-colors">
              Explore the Program
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Value Propositions Grid -->
  <section class="py-24 lg:py-32 gradient-navy relative overflow-hidden">
    <!-- Noise texture -->
    <div class="absolute inset-0 noise-overlay pointer-events-none"></div>

    <div class="container mx-auto px-4 lg:px-8 relative z-10">
      <SectionHeader 
        eyebrow="The Adullam Standard"
        title="Why This Academy Matters"
        description="We are preparing children for a world that doesn't exist yet, grounded in a Word that is eternal."
        light={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 max-w-5xl mx-auto">
        {approachItems.map((item, index) => (
          <FeatureCard 
            title={item.title}
            description={item.description}
            number={item.number}
            delay={index * 0.15}
          >
            <Fragment slot="icon">
              {item.number === 1 && (
                /* Code Icon */
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              )}
              {item.number === 2 && (
                /* Sparkles Icon */
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              )}
              {item.number === 3 && (
                /* Users Icon */
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              )}
              {item.number === 4 && (
                /* Lightning Bolt Icon */
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
            </Fragment>
          </FeatureCard>
        ))}
      </div>
    </div>
  </section>

  <!-- Student Showcase (Video Funnel) -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <SectionHeader 
        eyebrow="Evidence of Effectiveness"
        title="What Our Students Build"
        description="See the Adullam Method in action through student project walkthroughs."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto mt-12">
        <!-- Student Demo 1: Run David Run -->
        <div class="group relative aspect-video bg-navy-100 rounded-2xl overflow-hidden shadow-lg">
          <img src="/images/projects/run-david-run.gif" loading="lazy" width="800" height="450" alt="Run David Run 2D game demo built by an Adullam Academy student" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
          <div class="absolute inset-0 bg-linear-to-t from-navy-900/80 via-transparent to-transparent opacity-60"></div>
          <div class="absolute bottom-4 left-4">
            <p class="text-white font-bold text-lg">Run David Run!</p>
            <p class="text-gold-400 text-xs uppercase tracking-widest font-semibold">Student Project: 2D Adventure</p>
          </div>
        </div>

        <!-- Student Demo 2: Bible Bop -->
        <div class="group relative aspect-video bg-navy-100 rounded-2xl overflow-hidden shadow-lg">
          <img src="/videos/student-showcase/biblebop.gif" loading="lazy" width="800" height="450" alt="Bible Bop trivia game demo built by an Adullam Academy student" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
          <div class="absolute inset-0 bg-linear-to-t from-navy-900/80 via-transparent to-transparent opacity-60"></div>
          <div class="absolute bottom-4 left-4">
            <p class="text-white font-bold text-lg">Bible Bop</p>
            <p class="text-gold-400 text-xs uppercase tracking-widest font-semibold">Student Project: Trivia Game</p>
          </div>
        </div>

        <!-- Student Demo 3: Eseosa's Agent -->
        <div class="group relative aspect-video bg-navy-100 rounded-2xl overflow-hidden shadow-lg">
          <img src="/videos/student-showcase/ai-agent.gif" loading="lazy" width="800" height="450" alt="Eseosa's AI research agent demo built by an Adullam Academy student" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
          <div class="absolute inset-0 bg-linear-to-t from-navy-900/80 via-transparent to-transparent opacity-60"></div>
          <div class="absolute bottom-4 left-4">
            <p class="text-white font-bold text-lg">Eseosa's Agent</p>
            <p class="text-gold-400 text-xs uppercase tracking-widest font-semibold">Student Project: AI Research Agent</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-24 lg:py-32 bg-cream-dark relative">
    <div class="container mx-auto px-4 lg:px-8">
      <SectionHeader 
        eyebrow="Transformation"
        title="Results That Matter"
        description="Real stories from families who have experienced the Adullam Academy difference."
      />

      <div class="max-w-5xl mx-auto">
        <TestimonialCarousel testimonials={sortedTestimonials} />
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTA 
    headline="Equip Your Child for the New Age"
    subtext="Adullam Academy is a Kingdom-first preparation ground for effectiveness in innovation and leadership."
    primaryCTA="Apply Now"
    primaryLink={REGISTER_LINK}
    secondaryCTA="See the Program"
    secondaryLink="/bootcamp"
  />
</BaseLayout>

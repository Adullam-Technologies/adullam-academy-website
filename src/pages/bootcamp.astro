---
/**
 * Program Page - Redesigned for Adullam Academy: School of Innovation
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectShowcase from "../components/ProjectShowcase.astro";
import Stats from "../components/Stats.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import { REGISTER_LINK } from "../data/links";
import { getCollection } from "astro:content";

// Fetch projects from content collection
const projects = await getCollection("projects", ({ data }) => {
  return data.published === true;
});

// Sort by order and transform for ProjectShowcase
const sortedProjects = projects
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
  .map((p) => ({
    title: p.data.title,
    category: p.data.category,
    description: p.data.description,
    image:
      p.data.image ||
      `/images/projects/${p.data.category.toLowerCase().replace(" ", "-")}-placeholder.svg`,
  }));

// Fetch FAQs
const faqs = await getCollection("faq", ({ data }) => {
  return data.published === true;
});

const sortedFaqs = await Promise.all(
  faqs
    .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
    .map(async (faq) => {
      const { Content } = await faq.render();
      return {
        question: faq.data.question,
        answer: Content,
      };
    }),
);

// Program stats
const programStats = [
  { value: 8, label: "Weeks Long" },
  { value: 1, suffix: "hr", label: "Flexible Standups" },
  { value: 2, label: "Premium Tracks" },
  { value: 1, label: "Price ($300 CAD)" },
];

// Curriculum Breakdown
const modules = [
  {
    week: "Weeks 1-2",
    title: "Foundations & Vision",
    description: "Students master the core building blocks of their chosen track. Technical students learn Python logic, while Creative students master storyboarding and prompt design.",
    image: "/images/software/lms/coding-editor.png"
  },
  {
    week: "Weeks 3-5",
    title: "Architecture & Production",
    description: "Moving from theory to creation. Students begin building real applications and generating assets, applying their skills to complex workflows and challenges.",
    image: "/images/software/lms/lessons-page.png"
  },
  {
    week: "Weeks 6-7",
    title: "Integration & Refinement",
    description: "Bringing it all together. Technical students integrate the Google SDK for their AI agents, while Creative students edit and polish their Hollywood-style trailers.",
    image: "/images/software/ai-studio/gabriel-bible-agent.png"
  },
  {
    week: "Week 8",
    title: "Launch & Leadership",
    description: "The final showcase. Students present their prototypes and trailers, demonstrating both their mastery of the tools and the spiritual vision behind their innovation.",
    image: "/images/software/lms/quiz-page.png"
  }
];
---

<BaseLayout
  title="The Innovation Program | AI & Software Engineering for Kids"
  description="Join the Adullam Academy 8-week bootcamp. Two tracks: AI Engineering with Python or Creative Visionary video production for Kingdom-first leaders."
>
  <!-- Hero Section -->
  <section
    class="relative min-h-[70vh] flex items-center gradient-hero overflow-hidden"
  >
    <div class="absolute inset-0">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl animate-float"></div>
      <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-electric-500/10 rounded-full blur-3xl animate-float" style="animation-delay: -3s;"></div>
    </div>

    <div class="container mx-auto px-4 lg:px-8 py-32 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="animate-on-scroll">
          <div class="inline-block px-4 py-2 bg-gold-500/20 border border-gold-500/30 rounded-full text-gold-400 text-sm font-bold tracking-wider uppercase mb-6 shadow-glow">
            Summer Cohort: June 20 – August 16
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-6 leading-tight">
            Choose Your <span class="gradient-text">Path to Impact</span>
          </h1>
          <p class="text-xl text-white/80 mb-10 leading-relaxed">
            Our 8-week summer program offers two distinct tracks: Engineer industry-standard AI agents with Python, or produce a Hollywood-style movie trailer.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={REGISTER_LINK} class="btn-primary text-lg px-10 py-4 flex items-center justify-center gap-2 shadow-glow">
              Enrol Your Child
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
            </a>
            <a href="#tracks" class="btn-secondary text-lg px-10 py-4 flex items-center justify-center gap-2">
              Explore the Tracks
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </a>
          </div>
        </div>
        <div class="hidden lg:block animate-on-scroll-right">
          <div class="relative group">
            <div class="absolute -inset-4 bg-linear-to-br from-gold-500/30 to-electric-500/30 rounded-2xl blur-3xl opacity-50 group-hover:opacity-100 transition duration-500"></div>
            <img src="/images/software/lms/dashboard.png" alt="Adullam Academy LMS Platform Dashboard" class="relative rounded-2xl shadow-2xl border border-white/10" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Program Stats -->
  <section class="py-16 bg-cream-dark border-y border-navy-100/50">
    <div class="container mx-auto px-4 lg:px-8">
      <Stats stats={programStats} />
    </div>
  </section>

  <!-- Tracks Section -->
  <section id="tracks" class="py-24 lg:py-32 bg-white relative">
    <div class="container mx-auto px-4 lg:px-8">
      <SectionHeader
        eyebrow="Specialized Learning"
        title="Two Tracks of Excellence"
        description="Every student picks one track to master over the 8 weeks, guided by expert instruction."
      />

      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 mt-16 max-w-6xl mx-auto">
        <!-- Track 1 -->
        <div class="bg-navy-900 rounded-3xl p-8 lg:p-12 relative overflow-hidden group shadow-2xl border border-navy-800">
          <div class="absolute inset-0 bg-linear-to-br from-electric-500/10 to-transparent z-0 group-hover:opacity-75 transition-opacity"></div>
          <div class="relative z-10">
            <div class="w-16 h-16 bg-electric-500 rounded-2xl flex items-center justify-center mb-8">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>
            <h3 class="text-3xl font-extrabold text-white mb-4">Track 1: AI Engineering</h3>
            <p class="text-white/80 text-lg leading-relaxed mb-8">
              Students go beyond block-coding to write real Python code. They will learn industry-standard architecture, integrate with the Google SDK, and build functional AI agents.
            </p>
            <ul class="space-y-4 mb-8">
              <li class="flex items-center gap-3 text-white">
                <svg class="w-5 h-5 text-electric-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Master Python Fundamentals
              </li>
              <li class="flex items-center gap-3 text-white">
                <svg class="w-5 h-5 text-electric-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Google SDK Integration
              </li>
              <li class="flex items-center gap-3 text-white">
                <svg class="w-5 h-5 text-electric-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Build Functional AI Agents
              </li>
            </ul>
          </div>
        </div>

        <!-- Track 2 -->
        <div class="bg-gradient-to-br from-gold-500 to-gold-600 rounded-3xl p-8 lg:p-12 relative overflow-hidden group shadow-2xl">
          <div class="absolute inset-0 bg-white/10 z-0 group-hover:opacity-0 transition-opacity"></div>
          <div class="relative z-10">
            <div class="w-16 h-16 bg-navy-900 rounded-2xl flex items-center justify-center mb-8">
              <svg class="w-8 h-8 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/></svg>
            </div>
            <h3 class="text-3xl font-extrabold text-navy-900 mb-4">Track 2: Creative Visionary</h3>
            <p class="text-navy-800 text-lg leading-relaxed font-medium mb-8">
              Students learn to orchestrate advanced generative AI tools to direct, edit, and produce a breathtaking, Hollywood-style movie trailer from scratch.
            </p>
            <ul class="space-y-4 mb-8">
              <li class="flex items-center gap-3 text-navy-900 font-medium">
                <svg class="w-5 h-5 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Professional Storyboarding
              </li>
              <li class="flex items-center gap-3 text-navy-900 font-medium">
                <svg class="w-5 h-5 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Advanced Prompt Engineering
              </li>
              <li class="flex items-center gap-3 text-navy-900 font-medium">
                <svg class="w-5 h-5 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Video Production & Editing
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Logistics & Investment -->
  <section class="py-24 bg-cream-dark border-t border-navy-100/50">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 max-w-6xl mx-auto items-center">
        <div>
          <h2 class="text-3xl lg:text-4xl font-extrabold text-navy-900 mb-6">Flexible Schedule, <br/><span class="text-gold-600">Premium Value</span></h2>
          <p class="text-lg text-navy-700 leading-relaxed mb-8">
            We know families are busy. That's why we offer a highly flexible standup schedule to ensure your child gets the collaboration, feedback, and guidance they need.
          </p>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-white rounded-xl shadow-soft flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h4 class="text-xl font-bold text-navy-900 mb-1">June 20 – August 16</h4>
                <p class="text-navy-600">8 weeks of immersive, high-impact learning.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-white rounded-xl shadow-soft flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h4 class="text-xl font-bold text-navy-900 mb-1">Flexible Standups</h4>
                <p class="text-navy-600">Options from Tuesday to Sunday. Attend multiple sessions for max collaboration.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 lg:p-10 rounded-3xl shadow-xl border border-navy-100/50 text-center relative overflow-hidden">
          <div class="absolute top-0 inset-x-0 h-2 bg-gradient-to-r from-gold-400 to-gold-600"></div>
          <p class="text-navy-600 font-bold uppercase tracking-widest mb-4">Investment</p>
          <div class="text-5xl font-extrabold text-navy-900 mb-2">$300 <span class="text-2xl text-navy-500 font-medium">CAD</span></div>
          <p class="text-navy-500 mb-4">Per student, per track</p>
          <div class="inline-block px-4 py-2 bg-gold-500/10 rounded-full text-gold-600 text-sm font-semibold mb-8 border border-gold-500/20">
            Flexible: Pay $175/mo for 2 months
          </div>
          
          <ul class="space-y-4 text-left mb-10 max-w-sm mx-auto">
            <li class="flex items-center gap-3 text-navy-700">
              <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              8-week comprehensive curriculum
            </li>
            <li class="flex items-center gap-3 text-navy-700">
              <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Full access to Adullam LMS & AI Studio
            </li>
            <li class="flex items-center gap-3 text-navy-700">
              <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Live collaborative standup sessions
            </li>
            <li class="flex items-center gap-3 text-navy-700">
              <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Certificate of Completion
            </li>
          </ul>

          <a href={REGISTER_LINK} class="btn-primary w-full py-4 text-lg justify-center flex items-center gap-2">
            Secure Your Spot Now
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- The Adullam Method (Curriculum) -->
  <section id="curriculum" class="py-24 lg:py-32 bg-white relative">
    <div class="container mx-auto px-4 lg:px-8">
      <SectionHeader
        eyebrow="The Learning Journey"
        title="Our Curriculum Roadmap"
        description="A structured progression supporting both tracks to ensure every student thrives and builds an incredible final project."
      />

      <div class="mt-20 space-y-12">
        {modules.map((module, index) => (
          <div class={`flex flex-col ${index % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse'} items-center gap-12 lg:gap-20 p-8 lg:p-12 rounded-3xl bg-cream border border-navy-100/50 hover:border-gold-300 transition-all duration-500 shadow-soft`}>
            <div class="lg:w-1/2">
              <div class="relative group">
                <div class="absolute inset-0 bg-navy-900/5 rounded-2xl group-hover:bg-transparent transition-colors duration-300"></div>
                <img src={module.image} alt={`Adullam Academy curriculum: ${module.title}`} class="rounded-2xl shadow-xl border border-white" />
              </div>
            </div>
            <div class="lg:w-1/2">
              <span class="text-gold-600 font-extrabold text-sm uppercase tracking-widest mb-4 inline-block">{module.week}</span>
              <h3 class="text-3xl font-extrabold text-navy-900 mb-6">{module.title}</h3>
              <p class="text-lg text-navy-700 leading-relaxed">{module.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Instructor Bio -->
  <section class="py-24 lg:py-32 bg-cream-dark border-t border-navy-100/50">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <!-- Lead Instructor -->
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-24 lg:mb-32">
        <div class="animate-on-scroll-left">
           <div class="relative group max-w-md mx-auto">
                <img
                src="/images/founder-new.png"
                alt="Obaloluwa Odelana, Founder and Lead Instructor at Adullam Academy"
                class="relative w-full aspect-square object-cover rounded-full shadow-2xl transition-all duration-700"
              />
              <div class="absolute -bottom-4 -right-4 bg-navy-900 text-gold-500 p-6 rounded-2xl shadow-xl">
                <p class="text-xs font-bold uppercase tracking-widest mb-1">Lead Instructor</p>
                <p class="text-lg font-extrabold">Obaloluwa Odelana</p>
              </div>
           </div>
        </div>
        <div class="animate-on-scroll-right">
          <h2 class="text-3xl lg:text-4xl font-extrabold text-navy-900 mb-8 leading-tight">Learn from an <span class="text-gold-600">Industry Expert</span></h2>
          <div class="space-y-6 text-lg text-navy-700 leading-relaxed">
            <p>
              Obaloluwa Odelana is a Kingdom entrepreneur and software engineer with a background in <strong>AI research, automation engineering, and full-stack development</strong> across industry and academic settings. He has coached over 100 students in software development and led multiple high-impact youth innovation bootcamps.
            </p>
            <p>
              His work at the Academy focuses on engineering the <strong>Adullam Method</strong>, a Socratic, AI-driven learning approach that guides students toward technical mastery through the lens of God's creative wisdom.
            </p>
          </div>
        </div>
      </div>

      <!-- Creative Track Instructor -->
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="animate-on-scroll-right lg:order-2">
           <div class="relative group max-w-md mx-auto">
                <img
                src="/images/chim-wopara.png"
                alt="Chim Wopara, Creative Track Instructor at Adullam Academy"
                class="relative w-full aspect-square object-cover rounded-full shadow-2xl transition-all duration-700"
              />
              <div class="absolute -bottom-4 -right-4 bg-navy-900 text-gold-500 p-6 rounded-2xl shadow-xl">
                <p class="text-xs font-bold uppercase tracking-widest mb-1">Creative Track Instructor</p>
                <p class="text-lg font-extrabold">Chim Wopara</p>
              </div>
           </div>
        </div>
        <div class="animate-on-scroll-left lg:order-1">
          <h2 class="text-3xl lg:text-4xl font-extrabold text-navy-900 mb-8 leading-tight">Master the <span class="text-gold-600">Creative Frontier</span></h2>
          <div class="space-y-6 text-lg text-navy-700 leading-relaxed">
            <p>
              Chim Wopara is an entrepreneur and software developer who merges technical execution with economic strategy. He has engineered and launched over 20 tech products across fintech, logistics, and gaming, including Nairatraffic. As the founder of Wopara Group and Wopara University, Chim is dedicated to democratizing high-level tech education.
            </p>
            <p>
              His work focuses on high-impact creation, leveraging AI to build products that prioritize premium design and intuitive UX. At the Academy, he leads the <strong>Creative Track</strong>, empowering students to architect solutions that are both technically sophisticated and commercially viable.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="py-24 lg:py-32 bg-white scroll-mt-24">
    <div class="container mx-auto px-4 lg:px-8">
      <SectionHeader
        eyebrow="Got Questions?"
        title="Frequently Asked Questions"
        description="Everything you need to know about the upcoming cohort."
      />

      <div class="max-w-3xl mx-auto mt-12">
        <FAQ items={sortedFaqs} allowMultiple={true} title="" />
      </div>
    </div>
  </section>

  <!-- The Innovation Lab Section -->
  <section class="py-24 lg:py-32 gradient-navy relative overflow-hidden">
    <div class="absolute inset-0 noise-overlay opacity-10"></div>
    <div class="container mx-auto px-4 lg:px-8 relative z-10 text-center">
      <div class="max-w-4xl mx-auto mb-20">
        <h2 class="text-4xl lg:text-5xl font-extrabold text-white mb-6">Built on <span class="text-gold-500">Proprietary Technology</span></h2>
        <p class="text-xl text-white/70 leading-relaxed">
          We don't just teach technology, we build it. Adullam Academy runs on a custom-engineered ecosystem that ensures technical rigor and spiritual safety.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="p-8 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-sm text-left group hover:bg-white/10 transition-all duration-300">
          <div class="w-16 h-16 bg-gold-500 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
             <svg class="w-8 h-8 text-navy-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          </div>
          <h4 class="text-2xl font-bold text-white mb-4">Adullam LMS</h4>
          <p class="text-white/60 leading-relaxed text-sm">A professional-grade dashboard with an integrated code editor, gamified learning paths, and automated feedback loops.</p>
        </div>
        <div class="p-8 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-sm text-left group hover:bg-white/10 transition-all duration-300">
          <div class="w-16 h-16 bg-electric-500 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
             <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <h4 class="text-2xl font-bold text-white mb-4">AI Studio</h4>
          <p class="text-white/60 leading-relaxed text-sm">A safe frontier where students build AI agents guided by the Socratic Eureka Agent approach, filtered for spiritual safety.</p>
        </div>
        <div class="p-8 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-sm text-left group hover:bg-white/10 transition-all duration-300">
          <div class="w-16 h-16 bg-gold-400 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
             <svg class="w-8 h-8 text-navy-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h4 class="text-2xl font-bold text-white mb-4">AA Hints</h4>
          <p class="text-white/60 leading-relaxed text-sm">Our Socratic AI-helper that provides personalized hints based on your child's lesson history, errors, and context, guiding them forward without ever just giving the answer.</p>
        </div>
        <div class="p-8 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-sm text-left group hover:bg-white/10 transition-all duration-300">
